# ---------------------------------------------------------------
# WeaveSol - environment configuration
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ---------------------------------------------------------------

APP_NAME="WeaveSol"
APP_ENV=local                # local | production
APP_DEBUG=true               # MUST be false in production
APP_URL=http://localhost:8810
APP_TIMEZONE=Asia/Kolkata
# 64+ random hex chars. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=weavesol
DB_USERNAME=
DB_PASSWORD=
# Separate database used only by `php tests/run.php` (wiped on every run)
DB_TEST_DATABASE=weavesol_test

SESSION_NAME=WSSESSID
SESSION_LIFETIME_MINUTES=30  # inactivity timeout
SESSION_SECURE_COOKIE=false  # true when served over HTTPS

# Mail: log (writes to storage/mail) | smtp
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="WeaveSol"

# SMS: log (writes to storage/sms) | http (provider to be chosen)
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
# Shared secret the SMS provider sends with delivery reports (leave empty to turn reports off)
SMS_WEBHOOK_SECRET=

# Local PC backups
BACKUP_PATH=storage/backups
BACKUP_KEEP_DAYS=30

UPLOAD_MAX_MB=2
